BigButtonOption.MouseButton1Click:Connect(function()

	BigButtonEnabled = not BigButtonEnabled

	BigButton.Visible = BigButtonEnabled
	LockButton.Visible = BigButtonEnabled

	if BigButtonEnabled then
		BigButtonOption.Text = "Big Button Auto BJ: ON"
		BigButtonOptionStroke.Color = Color3.fromRGB(90, 200, 90)
	else
		BigButtonOption.Text = "Big Button Auto BJ"
		BigButtonOptionStroke.Color = Color3.fromRGB(55, 55, 55)
	end

end)

--==================================================
-- LOCK / UNLOCK
--==================================================

LockButton.MouseButton1Click:Connect(function()

	BigButtonUnlocked = not BigButtonUnlocked

	if BigButtonUnlocked then
		LockButton.Text = "🔓"
	else
		LockButton.Text = "🔒"
	end

end)

--==================================================
-- DRAG
--==================================================

local Dragging = false
local DragInput
local DragStart
local StartPosition
local WasDragged = false

local function UpdateBigButton(Input)

	if not BigButtonUnlocked then
		return
	end

	local Delta = Input.Position - DragStart

	if Delta.Magnitude > 5 then
		WasDragged = true
	end

	BigButton.Position = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)

	LockButton.Position = UDim2.new(
		BigButton.Position.X.Scale,
		BigButton.Position.X.Offset + 130,
		BigButton.Position.Y.Scale,
		BigButton.Position.Y.Offset + 39
	)

end

BigButton.InputBegan:Connect(function(Input)

	if not BigButtonUnlocked then
		return
	end

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		WasDragged = false
		DragStart = Input.Position
		StartPosition = BigButton.Position
		DragInput = Input

	end

end)

BigButton.InputChanged:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

		DragInput = Input

	end

end)

UserInputService.InputChanged:Connect(function(Input)

	if Dragging
		and BigButtonUnlocked
		and Input == DragInput then

		UpdateBigButton(Input)

	end

end)

UserInputService.InputEnded:Connect(function(Input)

	if Input == DragInput then

		Dragging = false
		DragInput = nil

	end

end)

--==================================================
-- BIG BUTTON EFEITOS
--==================================================

BigButton.MouseEnter:Connect(function()
	PlayHover()
	TweenService:Create(BigButton, TweenInfo.new(0.15), {
		BackgroundColor3 = Color3.fromRGB(35, 35, 35),
		Size = UDim2.new(0, 122, 0, 122),
		Position = UDim2.new(
			BigButton.Position.X.Scale,
			BigButton.Position.X.Offset - 4,
			BigButton.Position.Y.Scale,
			BigButton.Position.Y.Offset - 4
		)
	}):Play()

	TweenService:Create(BigButtonStroke, TweenInfo.new(0.15), {
		Color = Color3.fromRGB(255, 80, 80)
	}):Play()
end)

BigButton.MouseLeave:Connect(function()
	TweenService:Create(BigButton, TweenInfo.new(0.15), {
		BackgroundColor3 = Color3.fromRGB(10, 10, 10),
		Size = UDim2.new(0, 115, 0, 115),
		Position = UDim2.new(
			BigButton.Position.X.Scale,
			BigButton.Position.X.Offset + 4,
			BigButton.Position.Y.Scale,
			BigButton.Position.Y.Offset + 4
		)
	}):Play()

	TweenService:Create(BigButtonStroke, TweenInfo.new(0.15), {
		Color = Color3.fromRGB(255, 255, 255)
	}):Play()
end)

BigButton.MouseButton1Down:Connect(function()
	PlayClick()
	TweenService:Create(BigButton, TweenInfo.new(0.08), {
		BackgroundColor3 = Color3.fromRGB(70, 10, 10)
	}):Play()
end)

BigButton.MouseButton1Up:Connect(function()
	TweenService:Create(BigButton, TweenInfo.new(0.12), {
		BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	}):Play()
end)

--==================================================
-- BIG BUTTON ACTIVATION
--==================================================

BigButton.MouseButton1Click:Connect(function()

	if WasDragged then
		WasDragged = false
		return
	end

	if not Character
		or not Humanoid
		or Humanoid.Health <= 0
		or not Tool
		or not Tool.Parent then
		return
	end

	if Tool.Parent == Character then
		return
	end

	Humanoid:EquipTool(Tool)

	task.wait()

	if Tool.Parent == Character then
		Tool:Activate()
	end

	task.wait()

	if Humanoid and Humanoid.Parent then
		Humanoid:UnequipTools()
	end

end)
