--==================================================
-- TOOL HOLD ANIMATIONS (bloqueio)
--==================================================

local ToolHoldAnims = {
	-- R15
	["rbxassetid://507768375"] = true,
	["rbxassetid://507768133"] = true,
	["rbxassetid://522635514"] = true,
	["rbxassetid://522638767"] = true,
	-- R6
	["rbxassetid://182386253"] = true,
	["rbxassetid://182386221"] = true,
	["rbxassetid://182386188"] = true,
	["rbxassetid://182386147"] = true,
}

local ToolAnimConnection = nil

local function DisconnectToolAnimBlock()
	if ToolAnimConnection then
		ToolAnimConnection:Disconnect()
		ToolAnimConnection = nil
	end
end

local function StopHoldTracks()
	if not Animator then
		return
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
		local Anim = Track.Animation
		if Anim and ToolHoldAnims[Anim.AnimationId] then
			Track:Stop(0)
		end
	end
end

local function StartToolAnimBlock()
	if not Humanoid or not Humanoid.Parent then
		return
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		return
	end

	DisconnectToolAnimBlock()

	ToolAnimConnection = Animator.AnimationPlayed:Connect(function(Track)
		local Anim = Track.Animation
		if not Anim then
			return
		end

		if ToolHoldAnims[Anim.AnimationId] then
			Track:Stop(0)
		end
	end)

	StopHoldTracks()
end

-- Loop de reforço — evita qualquer hold anim escapar
task.spawn(function()
	while true do
		if Animator and Tool and Tool.Parent == Character then
			StopHoldTracks()
		end
		task.wait(0.1)
	end
end)

