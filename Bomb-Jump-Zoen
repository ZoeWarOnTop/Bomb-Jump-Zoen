--==================================================
-- SISTEMA DE ANIMAÇÃO DE MINIMIZAR / EXPANDIR (TWEEN)
--==================================================

local isAnimating = false
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

MenuButton.MouseButton1Click:Connect(function()
	if isAnimating then return end
	isAnimating = true

	if MenuFrame.Visible then
		-- MINIMIZAR PARA O BOTÃO
		SavedPosition = MenuFrame.Position -- Guarda a posição atual antes de fechar

		local tweenSize = TweenService:Create(MenuFrame, tweenInfo, {
			Size = UDim2.new(0, MenuButton.AbsoluteSize.X, 0, MenuButton.AbsoluteSize.Y),
			Position = MenuButton.Position
		})

		tweenSize:Play()
		tweenSize.Completed:Connect(function()
			MenuFrame.Visible = false
			isAnimating = false
		end)
	else
		-- EXPANDIR DO BOTÃO PARA A POSIÇÃO ANTERIOR
		MenuFrame.Size = UDim2.new(0, MenuButton.AbsoluteSize.X, 0, MenuButton.AbsoluteSize.Y)
		MenuFrame.Position = MenuButton.Position
		MenuFrame.Visible = true

		local tweenSize = TweenService:Create(MenuFrame, tweenInfo, {
			Size = OriginalSize,
			Position = SavedPosition
		})

		tweenSize:Play()
		tweenSize.Completed:Connect(function()
			isAnimating = false
		end)
	end
end)

