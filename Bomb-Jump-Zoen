--==================================================
-- FORÇAR FERRAMENTA NO 2º SLOT
--==================================================

local function ForceSecondSlot(targetTool)
	task.defer(function()
		local currentBackpack = Player:FindFirstChild("Backpack")
		if not currentBackpack or not targetTool or targetTool.Parent ~= currentBackpack then
			return
		end

		local tools = {}
		for _, item in ipairs(currentBackpack:GetChildren()) do
			if item:IsA("Tool") and item ~= targetTool then
				table.insert(tools, item)
			end
		end

		if #tools >= 1 then
			targetTool.Parent = nil
			for i, item in ipairs(tools) do
				if i == 2 then
					targetTool.Parent = currentBackpack
				end
				item.Parent = nil
				item.Parent = currentBackpack
			end
			if #tools < 2 then
				targetTool.Parent = currentBackpack
			end
		end
	end)
end

--==================================================
-- CRIAR PARTE COM A MESH DA FAKE C4
--==================================================

local function CreateBombPart()
	local Part = Instance.new("Part")
	Part.Name = "FakeC4Part"
	Part.Size = Vector3.new(1.45, 0.42, 0.9)
	Part.Color = Color3.fromRGB(20, 20, 20)
	Part.Material = Enum.Material.SmoothPlastic
	Part.TopSurface = Enum.SurfaceType.Smooth
	Part.BottomSurface = Enum.SurfaceType.Smooth

	local Mesh = Instance.new("SpecialMesh")
	Mesh.Name = "C4Mesh"
	Mesh.MeshType = Enum.MeshType.FileMesh
	Mesh.MeshId = BOMB_MESH_RAW
	Mesh.Scale = Vector3.new(1, 1, 1)
	Mesh.Parent = Part

	return Part
end

--==================================================
-- DROP DA C4 NO CHÃO
--==================================================

local function CreateDroppedBomb(Position)
	local Model = Instance.new("Model")
	Model.Name = "FakeC4Bomb"

	local Bomb = CreateBombPart()
	Bomb.CFrame = CFrame.new(Position)
	Bomb.Anchored = false
	Bomb.CanCollide = true
	Bomb.CanTouch = true
	Bomb.CanQuery = false

	Bomb.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.78, 0.15, 1, 1)

	Bomb.Parent = Model
	Model.PrimaryPart = Bomb
	Model.Parent = workspace

	if Character then
		for _, Part in ipairs(Character:GetDescendants()) do
			if Part:IsA("BasePart") then
				local NoCollision = Instance.new("NoCollisionConstraint")
				NoCollision.Part0 = Bomb
				NoCollision.Part1 = Part
				NoCollision.Parent = Bomb
			end
		end
	end

	local Exploded = false
	local TouchConnection

	local function Explode()
		if Exploded or not Model.Parent then return end
		Exploded = true

		if TouchConnection then
			TouchConnection:Disconnect()
			TouchConnection = nil
		end

		local ExplosionPosition = Bomb.Position
		Model:Destroy()

		-- Flash FX
		local Flash = Instance.new("Part")
		Flash.Name = "BombFlash"
		Flash.Shape = Enum.PartType.Ball
		Flash.Size = Vector3.new(1, 1, 1)
		Flash.Position = ExplosionPosition
		Flash.Anchored = true
		Flash.CanCollide = false
		Flash.Material = Enum.Material.Neon
		Flash.Color = Color3.fromRGB(255, 220, 70)
		Flash.Transparency = 0.05
		Flash.Parent = workspace

		-- Particle FX
		local ParticlePart = Instance.new("Part")
		ParticlePart.Name = "BombExplosionParticles"
		ParticlePart.Size = Vector3.new(1, 1, 1)
		ParticlePart.Position = ExplosionPosition
		ParticlePart.Anchored = true
		ParticlePart.CanCollide = false
		ParticlePart.Transparency = 1
		ParticlePart.Parent = workspace

		local ExplosionParticles = Instance.new("ParticleEmitter")
		ExplosionParticles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		ExplosionParticles.Rate = 0
		ExplosionParticles.Lifetime = NumberRange.new(0.3, 0.65)
		ExplosionParticles.Speed = NumberRange.new(8, 22)
		ExplosionParticles.SpreadAngle = Vector2.new(360, 360)
		ExplosionParticles.LightEmission = 1

		ExplosionParticles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.25, 0.8),
			NumberSequenceKeypoint.new(1, 0)
		})

		ExplosionParticles.Color = ColorSequence.new(
			Color3.fromRGB(255, 245, 110),
			Color3.fromRGB(255, 110, 10)
		)

		ExplosionParticles.Parent = ParticlePart
		ExplosionParticles:Emit(85)

		task.spawn(function()
			for i = 1, 12 do
				if not Flash.Parent then break end
				local Size = 1 + i * 0.7
				Flash.Size = Vector3.new(Size, Size, Size)
				Flash.Transparency = 0.05 + (i / 12) * 0.95
				task.wait(0.02)
			end
			if Flash then Flash:Destroy() end
		end)

		Debris:AddItem(ParticlePart, 0.8)
	end

	TouchConnection = Bomb.Touched:Connect(function(Hit)
		if Exploded or not Model.Parent then return end
		if not Hit or not Hit:IsA("BasePart") then return end
		if Character and Hit:IsDescendantOf(Character) then return end

		Exploded = true
		task.delay(1, function()
			if not Model.Parent then return end
			Exploded = false
			Explode()
		end)
	end)

	return Model
end

--==================================================
-- CRIAR TOOL
--==================================================

local function CreateTool()
	Backpack = Player:WaitForChild("Backpack")

	local Old = Backpack:FindFirstChild("Bomb")
	if Old then Old:Destroy() end
	if Character and Character:FindFirstChild("Bomb") then
		Character:FindFirstChild("Bomb"):Destroy()
	end

	local NewTool = Instance.new("Tool")
	NewTool.Name = "Bomb"
	NewTool.ToolTip = "Bomb Jump"
	NewTool.TextureId = BOMB_ICON_RAW
	NewTool.RequiresHandle = true
	NewTool.CanBeDropped = false

	NewTool.Grip = CFrame.new(0, -0.15, 0) * CFrame.Angles(0, math.rad(90), 0)

	local Handle = CreateBombPart()
	Handle.Name = "Handle"
	Handle.CanCollide = false
	Handle.CanTouch = false
	Handle.Massless = true
	Handle.Parent = NewTool

	NewTool.Activated:Connect(function()
		if Cooldown then return end
		if not Character or Humanoid.Health <= 0 or not Root then return end
		if NewTool.Parent ~= Character then return end

		local State = Humanoid:GetState()
		local VerticalVelocity = Root.AssemblyLinearVelocity.Y
		local IsFalling = State == Enum.HumanoidStateType.Freefall and VerticalVelocity < -0.1

		if not IsFalling then return end

		Cooldown = true

		local CurrentVelocity = Root.AssemblyLinearVelocity
		local JumpVelocity = Humanoid.UseJumpPower and Humanoid.JumpPower or math.sqrt(2 * workspace.Gravity * Humanoid.JumpHeight)

		Root.AssemblyLinearVelocity = Vector3.new(CurrentVelocity.X, JumpVelocity, CurrentVelocity.Z)

		for _, Object in ipairs(NewTool:GetDescendants()) do
			if Object:IsA("BasePart") then
				Object.Transparency = 1
			end
		end

		local FeetPosition = Root.Position - Vector3.new(0, 2.6, 0)
		local BombPosition = FeetPosition + Vector3.new(0, 0.45, 0)

		CreateDroppedBomb(BombPosition)

		task.delay(Config.Cooldown, function()
			if NewTool and NewTool.Parent then
				for _, Object in ipairs(NewTool:GetDescendants()) do
					if Object:IsA("BasePart") then
						Object.Transparency = 0
					end
				end
			end
			Cooldown = false
		end)
	end)

	NewTool.Parent = Backpack
	Tool = NewTool
	
	ForceSecondSlot(NewTool)

	return NewTool
end

--==================================================
-- MONITORAMENTO DE INVENTÁRIO
--==================================================

task.spawn(function()
	while true do
		task.wait(0.5)
		if Character and Humanoid and Humanoid.Health > 0 then
			Backpack = Player:FindFirstChild("Backpack")
			local hasInBackpack = Backpack and Backpack:FindFirstChild("Bomb")
			local hasInCharacter = Character:FindFirstChild("Bomb")

			if not hasInBackpack and not hasInCharacter then
				CreateTool()
			elseif hasInBackpack then
				ForceSecondSlot(hasInBackpack)
			end
		end
	end
end)

