--==================================================
-- STOP EQUIP ANIMATION
--==================================================

local function StopEquipAnimation()
	if not Humanoid then
		return
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
		local Animation = Track.Animation

		if Animation then
			local ID = Animation.AnimationId:lower()

			if ID:find("equip")
				or ID:find("tool")
				or ID:find("hold") then

				Track:Stop(0)
			end
		end
	end
end

--==================================================
-- KEEP ARM DOWN
--==================================================

local function KeepArmDown()
	if not Character then
		return
	end

	local Torso =
		Character:FindFirstChild("Torso")
		or Character:FindFirstChild("UpperTorso")

	if not Torso then
		return
	end

	local Shoulder =
		Torso:FindFirstChild("Right Shoulder")
		or Torso:FindFirstChild("RightShoulder")

	if Shoulder and Shoulder:IsA("Motor6D") then
		Shoulder.Transform = CFrame.new()
	end
end

--==================================================
-- CREATE BLACK RECTANGULAR BOMB
--==================================================

local function CreateBomb(Position, Direction)
	local Bomb = Instance.new("Part")

	Bomb.Name = "Bomb"
	Bomb.Size = Vector3.new(2.8, 0.85, 1.6)

	Bomb.CFrame = CFrame.lookAt(
		Position,
		Position + Direction
	)

	Bomb.Anchored = false
	Bomb.CanCollide = true
	Bomb.CanTouch = true
	Bomb.CanQuery = false

	Bomb.Material = Enum.Material.SmoothPlastic
	Bomb.Color = Color3.fromRGB(0, 0, 0)

	Bomb.CustomPhysicalProperties = PhysicalProperties.new(
		0.7,
		0.78,
		0.15,
		1,
		1
	)

	Bomb.Parent = workspace

	--==================================================
	-- PREVENT COLLISION WITH PLAYER
	--==================================================

	if Character then
		for _, Part in ipairs(Character:GetDescendants()) do
			if Part:IsA("BasePart") then
				local NoCollision =
					Instance.new("NoCollisionConstraint")

				NoCollision.Part0 = Bomb
				NoCollision.Part1 = Part
				NoCollision.Parent = Bomb
			end
		end
	end

	--==================================================
	-- THROW
	--==================================================

	Bomb.AssemblyLinearVelocity =
		Direction.Unit * Config.ThrowForce
		+ Vector3.new(0, 8, 0)

	--==================================================
	-- EXPLOSION
	--==================================================

	local Exploded = false
	local TouchConnection

	local function Explode()
		if Exploded or not Bomb.Parent then
			return
		end

		Exploded = true

		if TouchConnection then
			TouchConnection:Disconnect()
			TouchConnection = nil
		end

		local Explosion = Instance.new("Explosion")

		Explosion.Position = Bomb.Position

		-- No physical force.
		Explosion.BlastRadius = 0
		Explosion.BlastPressure = 0
		Explosion.DestroyJointRadiusPercent = 0

		Explosion.Parent = workspace

		Bomb:Destroy()
	end

	TouchConnection = Bomb.Touched:Connect(function(Hit)
		if Exploded or not Bomb.Parent then
			return
		end

		if not Hit or not Hit:IsA("BasePart") then
			return
		end

		if Character and Hit:IsDescendantOf(Character) then
			return
		end

		-- Explode immediately on contact.
		Explode()
	end)

	Debris:AddItem(Bomb, 10)

	return Bomb
end

--==================================================
-- THROW BOMB
--==================================================

local function ThrowBomb()
	if Cooldown then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		return
	end

	if Tool.Parent ~= Character then
		return
	end

	Cooldown = true

	StopEquipAnimation()
	KeepArmDown()

	local Direction = Root.CFrame.LookVector

	local Position =
		Root.Position
		+ Direction * 2.5
		+ Vector3.new(0, -0.5, 0)

	CreateBomb(Position, Direction)

	task.delay(Config.Cooldown, function()
		Cooldown = false
	end)
end

