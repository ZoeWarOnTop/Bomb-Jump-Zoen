--==================================================
-- BIG BUTTON DRAG
--==================================================

local Dragging = false
local DragInput
local DragStart
local StartPosition
local WasDragged = false

local function UpdateBigButton(Input)
	if not BigButtonUnlocked then
		return
	end

	local Delta = Input.Position - DragStart

	if Delta.Magnitude > 5 then
		WasDragged = true
	end

	BigButton.Position = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)

	LockButton.Position = UDim2.new(
		BigButton.Position.X.Scale,
		BigButton.Position.X.Offset + 130,
		BigButton.Position.Y.Scale,
		BigButton.Position.Y.Offset + 39
	)
end

BigButton.InputBegan:Connect(function(InputObject)
	if not BigButtonUnlocked then
		return
	end

	if InputObject.UserInputType == Enum.UserInputType.MouseButton1
		or InputObject.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		WasDragged = false
		DragStart = InputObject.Position
		StartPosition = BigButton.Position
		DragInput = InputObject
	end
end)

BigButton.InputChanged:Connect(function(InputObject)
	if InputObject.UserInputType == Enum.UserInputType.MouseMovement
		or InputObject.UserInputType == Enum.UserInputType.Touch then

		DragInput = InputObject
	end
end)

UserInputService.InputChanged:Connect(function(InputObject)
	if Dragging
		and BigButtonUnlocked
		and InputObject == DragInput then

		UpdateBigButton(InputObject)
	end
end)

UserInputService.InputEnded:Connect(function(InputObject)
	if InputObject == DragInput then
		Dragging = false
		DragInput = nil
	end
end)

--==================================================
-- BIG BUTTON BOMB JUMP
--==================================================

BigButton.MouseButton1Click:Connect(function()
	if WasDragged then
		WasDragged = false
		return
	end

	if not Character
		or not Humanoid
		or Humanoid.Health <= 0 then

		return
	end

	if Tool.Parent ~= Character then
		Humanoid:EquipTool(Tool)
		task.wait()

		if Tool.Parent ~= Character then
			return
		end
	end

	BombJump()
end)

