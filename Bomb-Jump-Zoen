			not BigButtonEnabled

		BigButton.Visible =
			BigButtonEnabled

		LockButton.Visible =
			BigButtonEnabled

		if BigButtonEnabled then

			BigButtonOption.Text =
				"Big Button Auto BJ: ON"

		else

			BigButtonOption.Text =
				"Big Button Auto BJ"

		end

	end
)

--==================================================
-- LOCK / UNLOCK
--==================================================

LockButton.MouseButton1Click:Connect(
	function()

		BigButtonUnlocked =
			not BigButtonUnlocked

		if BigButtonUnlocked then

			LockButton.Text =
				"🔓"

		else

			LockButton.Text =
				"🔒"

		end

	end
)

--==================================================
-- BIG BUTTON DRAG
--==================================================

local Dragging = false
local DragInput
local DragStart
local StartPosition
local WasDragged = false

local function UpdateBigButton(Input)

	if not BigButtonUnlocked then
		return
	end

	local Delta =
		Input.Position -
		DragStart

	if Delta.Magnitude > 5 then
		WasDragged = true
	end

	BigButton.Position =
		UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

	LockButton.Position =
		UDim2.new(
			BigButton.Position.X.Scale,
			BigButton.Position.X.Offset + 130,
			BigButton.Position.Y.Scale,
			BigButton.Position.Y.Offset + 39
		)

end

BigButton.InputBegan:Connect(
	function(Input)

		if not BigButtonUnlocked then
			return
		end

		if Input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or Input.UserInputType ==
			Enum.UserInputType.Touch then

			Dragging = true
			WasDragged = false
			DragStart = Input.Position
			StartPosition = BigButton.Position
			DragInput = Input

		end

	end
)

BigButton.InputChanged:Connect(
	function(Input)

		if Input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or Input.UserInputType ==
			Enum.UserInputType.Touch then

			DragInput = Input

		end

	end
)

UserInputService.InputChanged:Connect(
	function(Input)

		if Dragging
			and BigButtonUnlocked
			and Input == DragInput then

			UpdateBigButton(Input)

		end

	end
)

UserInputService.InputEnded:Connect(
	function(Input)

		if Input == DragInput then

			Dragging = false
			DragInput = nil

		end

	end
)

--==================================================
-- BIG BUTTON ACTIVATION
--==================================================

BigButton.MouseButton1Click:Connect(
	function()

		if WasDragged then

			WasDragged = false
			return

		end

		if not Character
			or not Humanoid
			or Humanoid.Health <= 0 then

			return
		end

		if Tool.Parent ~= Character then

			Humanoid:EquipTool(Tool)

			task.wait()

			if Tool.Parent ~= Character then
				return
			end

		end

		BombJump()

	end
)

--==================================================
-- FINAL CLEANUP
--==================================================

for _, Item in ipairs(
	Backpack:GetChildren()
) do

	if Item:IsA("Tool")
		and Item.Name == "Bomb"
		and Item ~= Tool then

		Item:Destroy()

	end

end

if Character then

	for _, Item in ipairs(
		Character:GetChildren()
	) do

		if Item:IsA("Tool")
			and Item.Name == "Bomb"
			and Item ~= Tool then

			Item:Destroy()

		end

	end

end

Tool.Parent = Backpack
