-- DRAG DO BIG BUTTON
local Dragging = false
local DragInput, DragStart, StartPosition
local WasDragged = false

BigButton.InputBegan:Connect(function(InputObj)
	if not BigButtonUnlocked then return end
	if InputObj.UserInputType == Enum.UserInputType.MouseButton1 or InputObj.UserInputType == Enum.UserInputType.Touch then
		Dragging = true
		WasDragged = false
		DragStart = InputObj.Position
		StartPosition = BigButton.Position
		DragInput = InputObj
	end
end)

UserInputService.InputChanged:Connect(function(InputObj)
	if Dragging and BigButtonUnlocked and InputObj == DragInput then
		local Delta = InputObj.Position - DragStart
		if Delta.Magnitude > 5 then WasDragged = true end

		BigButton.Position = UDim2.new(
			StartPosition.X.Scale, StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y
		)
		LockButton.Position = UDim2.new(
			BigButton.Position.X.Scale, BigButton.Position.X.Offset + 120,
			BigButton.Position.Y.Scale, BigButton.Position.Y.Offset + 37
		)
	end
end)

UserInputService.InputEnded:Connect(function(InputObj)
	if InputObj == DragInput then
		Dragging = false
		DragInput = nil
	end
end)

--==================================================
-- TOOL & FUNCIONALIDADE DA BOMBA
--==================================================

local function GiveTool()
	local Backpack = Player:WaitForChild("Backpack")

	local OldTool = Backpack:FindFirstChild("Bomb") or (Character and Character:FindFirstChild("Bomb"))
	if OldTool then OldTool:Destroy() end

	Tool = Instance.new("Tool")
	Tool.Name = "Bomb"
	Tool.ToolTip = "Bomb Jump"
	Tool.RequiresHandle = false -- Sem animação no braço
	Tool.CanBeDropped = false
	Tool.ManualActivationOnly = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if Cooldown then return end
		if not Character or not Humanoid or Humanoid.Health <= 0 or not Root then return end
		if Tool.Parent ~= Character then return end

		local State = Humanoid:GetState()
		local IsFalling = State == Enum.HumanoidStateType.Freefall and Root.AssemblyLinearVelocity.Y < -0.1

		if not IsFalling then return end

		Cooldown = true

		-- PULO IMEDIATO
		local JumpVelocity = Humanoid.UseJumpPower and Humanoid.JumpPower or math.sqrt(2 * workspace.Gravity * Humanoid.JumpHeight)
		Root.AssemblyLinearVelocity = Vector3.new(Root.AssemblyLinearVelocity.X, JumpVelocity, Root.AssemblyLinearVelocity.Z)

		-- BOMBA RETÂNGULO NOS PÉS
		local FeetPosition = Root.Position - Vector3.new(0, 2.6, 0)
		local BombPosition = FeetPosition + Vector3.new(0, 0.45, 0)

		local Bomb = Instance.new("Part")
		Bomb.Name = "Bomb"
		Bomb.Shape = Enum.PartType.Block
		Bomb.Size = Vector3.new(0.8, 0.6, 1.2)
		Bomb.Position = BombPosition
		Bomb.Anchored = false
		Bomb.CanCollide = true
		Bomb.CanTouch = true
		Bomb.CanQuery = false
		Bomb.Material = Enum.Material.SmoothPlastic
		Bomb.Color = Color3.fromRGB(8, 8, 8)
		Bomb.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.78, 0.15, 1, 1)
		Bomb.Parent = workspace

		-- NO COLLISION COM PLAYER
		for _, Part in ipairs(Character:GetDescendants()) do
			if Part:IsA("BasePart") then
				local NoCollision = Instance.new("NoCollisionConstraint")
				NoCollision.Part0 = Bomb
				NoCollision.Part1 = Part
				NoCollision.Parent = Bomb
			end
		end

		-- EXPLODE APÓS 3 SEGUNDOS NO CHÃO
		local Exploded = false
		local TouchConnection
		TouchConnection = Bomb.Touched:Connect(function(Hit)
			if Exploded or not Bomb.Parent then return end
			if not Hit or not Hit:IsA("BasePart") or (Character and Hit:IsDescendantOf(Character)) then return end

			Exploded = true

			task.delay(3, function()
				if not Bomb.Parent then return end
				if TouchConnection then TouchConnection:Disconnect() end

				local ExplosionPosition = Bomb.Position
				Bomb.Transparency = 1

				-- FLASH & PARTICULAS
				local Flash = Instance.new("Part")
				Flash.Shape = Enum.PartType.Ball
				Flash.Size = Vector3.new(1, 1, 1)
				Flash.Position = ExplosionPosition
				Flash.Anchored = true
				Flash.CanCollide = false
				Flash.Material = Enum.Material.Neon
				Flash.Color = Color3.fromRGB(255, 220, 70)
				Flash.Transparency = 0.05
				Flash.Parent = workspace

				local ParticlePart = Instance.new("Part")
				ParticlePart.Size = Vector3.new(1, 1, 1)
				ParticlePart.Position = ExplosionPosition
				ParticlePart.Anchored = true
				ParticlePart.CanCollide = false
				ParticlePart.Transparency = 1
				ParticlePart.Parent = workspace

				local ExplosionParticles = Instance.new("ParticleEmitter")
				ExplosionParticles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				ExplosionParticles.Rate = 0
				ExplosionParticles.Lifetime = NumberRange.new(0.3, 0.65)
				ExplosionParticles.Speed = NumberRange.new(8, 22)
				ExplosionParticles.SpreadAngle = Vector2.new(360, 360)
				ExplosionParticles.LightEmission = 1
				ExplosionParticles.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.45),
					NumberSequenceKeypoint.new(0.25, 0.8),
					NumberSequenceKeypoint.new(1, 0)
				})
				ExplosionParticles.Color = ColorSequence.new(Color3.fromRGB(255, 245, 110), Color3.fromRGB(255, 110, 10))
				ExplosionParticles.Parent = ParticlePart
				ExplosionParticles:Emit(85)

				task.spawn(function()
					for i = 1, 12 do
						if not Flash.Parent then break end
						Flash.Size = Vector3.new(1 + i * 0.7, 1 + i * 0.7, 1 + i * 0.7)
						Flash.Transparency = 0.05 + (i / 12) * 0.95
						task.wait(0.02)
					end
					if Flash then Flash:Destroy() end
				end)

				Debris:AddItem(ParticlePart, 0.8)
				Bomb:Destroy()
			end)
		end)

		task.delay(Config.Cooldown, function()
			Cooldown = false
		end)
	end)
end

-- CLIQUE NO BIG BUTTON AUTO BJ
BigButton.MouseButton1Click:Connect(function()
	if WasDragged then
		WasDragged = false
		return
	end

	if not Character or not Humanoid or Humanoid.Health <= 0 or not Tool then return end

	if Tool.Parent ~= Character then
		Humanoid:EquipTool(Tool)
		task.wait()
	end

	if Tool.Parent == Character then
		Tool:Activate()
	end

	task.wait()
	if Humanoid and Humanoid.Parent then
		Humanoid:UnequipTools()
	end
end)

