local Dragging = false
local DragInput
local DragStart
local StartPosition
local WasDragged = false

local function UpdateBigButton(Input)
    if not BigButtonUnlocked then return end  
    local Delta = Input.Position - DragStart  
    if Delta.Magnitude > 5 then  
        WasDragged = true  
    end  
    BigButton.Position = UDim2.new(  
        StartPosition.X.Scale,  
        StartPosition.X.Offset + Delta.X,  
        StartPosition.Y.Scale,  
        StartPosition.Y.Offset + Delta.Y  
    )  
    LockButton.Position = UDim2.new(  
        BigButton.Position.X.Scale,  
        BigButton.Position.X.Offset + 130,  
        BigButton.Position.Y.Scale,  
        BigButton.Position.Y.Offset + 39  
    )
end

BigButton.InputBegan:Connect(function(Input)
    if not BigButtonUnlocked then return end  
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then  
        Dragging = true  
        WasDragged = false  
        DragStart = Input.Position  
        StartPosition = BigButton.Position  
        DragInput = Input  
    end
end)

BigButton.InputChanged:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then  
        DragInput = Input  
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and BigButtonUnlocked and Input == DragInput then  
        UpdateBigButton(Input)  
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input == DragInput then  
        Dragging = false  
        DragInput = nil  
    end
end)

BigButton.MouseButton1Click:Connect(function()
    if WasDragged then  
        WasDragged = false  
        return  
    end  

    if not Character or not Humanoid or Humanoid.Health <= 0 or not Tool or not Tool.Parent then  
        return  
    end  

    if Tool.Parent == Character then  
        Tool:Activate()
        return  
    end  

    Humanoid:EquipTool(Tool)  
    task.wait()  

    if Tool.Parent == Character then  
        Tool:Activate()  
    end  

    task.wait()  

    if Humanoid and Humanoid.Parent then  
        Humanoid:UnequipTools()  
    end
end)
