		SurfaceGui.Face = Enum.NormalId.Top
		SurfaceGui.Parent = Brick

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, 0, 1, 0)
		Label.BackgroundTransparency = 1
		Label.Text = "C4\nEXPLOSIVE"
		Label.TextColor3 = Color3.fromRGB(210, 210, 130)
		Label.TextScaled = true
		Label.Font = Enum.Font.GothamBold
		Label.Parent = SurfaceGui
	end

	-- Central Device Body (Black Plate)
	local Device = Instance.new("Part")
	Device.Name = "Device"
	Device.Size = Vector3.new(0.75, 0.42, 0.95)
	Device.Color = Color3.fromRGB(25, 25, 25)
