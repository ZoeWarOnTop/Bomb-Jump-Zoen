local function BuildC4Model()
	local MainModel = Instance.new("Model")
	MainModel.Name = "FakeC4Model"

	-- Base / Center Assembly
	local RootPart = Instance.new("Part")
	RootPart.Name = "Handle"
	RootPart.Size = Vector3.new(1.3, 0.4, 1.3)
	RootPart.Transparency = 1
	RootPart.CanCollide = false
	RootPart.Massless = true
	RootPart.Parent = MainModel
	MainModel.PrimaryPart = RootPart

	local function Weld(p0, p1, c0)
		local w = Instance.new("Weld")
		w.Part0 = p0
		w.Part1 = p1
		w.C0 = c0 or CFrame.new()
		w.Parent = p0
	end

	-- 4 C4 Explosive Bricks
	local brickColor = Color3.fromRGB(115, 125, 115)
	local brickPositions = {
		Vector3.new(-0.35, 0, -0.35),
		Vector3.new(0.35, 0, -0.35),
		Vector3.new(-0.35, 0, 0.35),
		Vector3.new(0.35, 0, 0.35)
	}

	for i, pos in ipairs(brickPositions) do
		local Brick = Instance.new("Part")
		Brick.Name = "C4Block_" .. i
		Brick.Size = Vector3.new(0.65, 0.35, 0.65)
		Brick.Color = brickColor
		Brick.Material = Enum.Material.SmoothPlastic
		Brick.CanCollide = false
		Brick.Massless = true
		Brick.Parent = MainModel

		Weld(RootPart, Brick, CFrame.new(pos))

		-- Text "C4 EXPLOSIVE"
