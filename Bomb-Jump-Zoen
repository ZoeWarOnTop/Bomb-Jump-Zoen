local function updateColorOutput()
	bombColor = Color3.fromHSV(currentH, currentS, currentV)
	SatValPicker.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
	PreviewBox.BackgroundColor3 = bombColor
	HexBox.Text = "#" .. bombColor:ToHex():upper()
