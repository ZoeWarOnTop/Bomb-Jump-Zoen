--// .ZOEWAR - BOMB JUMP
--// Black rectangular block
--// Invisible Handle
--// No equip animation
--// Click to throw the block forward
--// No falling restriction
--// Explosion only
--// No particles, fuse, or extra effects
--// No explosion force

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local LocalPlayer = Players.LocalPlayer

local TOOL_NAME = "Bomb"
local COOLDOWN = 2
local THROW_FORCE = 75

local equipped = false
local debounce = false

local character
local humanoid
local root

local Tool = Instance.new("Tool")
Tool.Name = TOOL_NAME
Tool.RequiresHandle = true
Tool.CanBeDropped = false

local Handle = Instance.new("Part")
Handle.Name = "Handle"
Handle.Size = Vector3.new(0.2, 0.2, 0.2)
Handle.Transparency = 1
Handle.CanCollide = false
Handle.CanTouch = false
Handle.CanQuery = false
Handle.Massless = true
Handle.Parent = Tool

local function updateCharacter()
	character = LocalPlayer.Character

	if not character then
		humanoid = nil
		root = nil
		return
	end

	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
end

updateCharacter()

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.2)
	updateCharacter()
end)

local function stopEquipAnimations()
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		return
	end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animation = track.Animation

		if animation then
			local animationId = animation.AnimationId:lower()

			if animationId:find("tool")
				or animationId:find("equip")
				or animationId:find("hold") then
				track:Stop(0)
			end
		end
	end
end

local function keepArmDown()
	if not character then
		return
	end

	local torso = character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")

	if not torso then
		return
	end

	local shoulder = torso:FindFirstChild("Right Shoulder")
		or torso:FindFirstChild("RightShoulder")

	if shoulder and shoulder:IsA("Motor6D") then
		if not shoulder:GetAttribute("ZoeWarOriginalC0") then
			shoulder:SetAttribute("ZoeWarOriginalC0", true)
		end

		shoulder.C0 = CFrame.new(1.5, 0, 0)
			* CFrame.Angles(0, 0, 0)
	end
end

local function createBomb(position, direction)
	local bomb = Instance.new("Part")
	bomb.Name = "BlackBomb"
	bomb.Size = Vector3.new(2.6, 0.8, 1.5)
	bomb.CFrame = CFrame.new(position)
	bomb.Color = Color3.fromRGB(0, 0, 0)
	bomb.Material = Enum.Material.SmoothPlastic
	bomb.TopSurface = Enum.SurfaceType.Smooth
	bomb.BottomSurface = Enum.SurfaceType.Smooth
	bomb.Anchored = false
	bomb.CanCollide = true
	bomb.CanTouch = true
	bomb.CanQuery = true
	bomb.Massless = false
	bomb.Parent = workspace

	bomb.AssemblyLinearVelocity = direction.Unit * THROW_FORCE

	local exploded = false

	bomb.Touched:Connect(function()
		if exploded or not bomb.Parent then
			return
		end

		exploded = true

		local explosion = Instance.new("Explosion")
		explosion.Position = bomb.Position
		explosion.BlastRadius = 0
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0
		explosion.Parent = workspace

		bomb:Destroy()
	end)

	Debris:AddItem(bomb, 10)
end

local function throwBomb()
	if not equipped or debounce then
		return
	end

	updateCharacter()

	if not root then
		return
	end

	debounce = true

	local direction = root.CFrame.LookVector
	local spawnPosition =
		root.Position
		+ direction * 2
		+ Vector3.new(0, -0.5, 0)

	createBomb(spawnPosition, direction)

	task.delay(COOLDOWN, function()
		debounce = false
	end)
end

Tool.Equipped:Connect(function()
	equipped = true
	updateCharacter()

	task.defer(function()
		stopEquipAnimations()
		keepArmDown()
	end)
end)

Tool.Unequipped:Connect(function()
	equipped = false
end)

Tool.Activated:Connect(function()
	throwBomb()
end)

RunService.RenderStepped:Connect(function()
	if equipped then
		stopEquipAnimations()
		keepArmDown()
	end
end)

Tool.Parent = LocalPlayer:WaitForChild("Backpack")
