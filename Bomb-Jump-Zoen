--==================================================
-- BLOQUEIO DE ANIMAÇÕES DO BRAÇO AO EQUIPAR
--==================================================

local AnimRenderConnection = nil

local function DisconnectToolAnimBlock()
    if AnimRenderConnection then
        AnimRenderConnection:Disconnect()
        AnimRenderConnection = nil
    end
end

local function StartToolAnimBlock()
    DisconnectToolAnimBlock()
    
    -- Para todas as animações ativas e bloqueia qualquer uma que tente rodar enquanto equipada
    AnimRenderConnection = RunService.PreRender:Connect(function()
        if not Humanoid or not Humanoid.Parent then return end
        Animator = Humanoid:FindFirstChildOfClass("Animator")
        if not Animator then return end

        for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do
            local animId = track.Animation and track.Animation.AnimationId
            -- Para animações conhecidas de segurar ferramenta ou de prioridade Tool
            if track.Priority == Enum.AnimationPriority.Action or track.Priority == Enum.AnimationPriority.Idle then
                if animId and (
                    animId:find("507768375") or animId:find("507768133") or 
                    animId:find("522635514") or animId:find("522638767") or
                    animId:find("182386253") or animId:find("182386221") or 
                    animId:find("182386188") or animId:find("182386147")
                ) then
                    track:Stop(0)
                end
            end
        end
    end)
end

