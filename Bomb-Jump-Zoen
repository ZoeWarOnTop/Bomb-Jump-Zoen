--// .ZOEWAR - BOMB JUMP (AJUSTADO)

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Player = Players.LocalPlayer
local Backpack = Player:WaitForChild("Backpack")

local Character
local Humanoid
local Root

local Cooldown = false

--==================================================
-- CHARACTER
--==================================================

local function SetupCharacter(Char)
    Character = Char
    Humanoid = Char:WaitForChild("Humanoid")
    Root = Char:WaitForChild("HumanoidRootPart")
    Cooldown = false
end

SetupCharacter(Player.Character or Player.CharacterAdded:Wait())

Player.CharacterAdded:Connect(function(Char)
    SetupCharacter(Char)
end)

--==================================================
-- TOOL
--==================================================

local Old = Backpack:FindFirstChild("Bomb")
if Old then
    Old:Destroy()
end

local Tool = Instance.new("Tool")
Tool.Name = "Bomb"
Tool.ToolTip = "Bomb Jump"
Tool.RequiresHandle = false -- Remove a animação padrão do braço levantar
Tool.CanBeDropped = false
Tool.ManualActivationOnly = false
Tool.Parent = Backpack

--==================================================
-- CRIAR BOMBA (RETÂNGULO)
--==================================================

local function CreateBomb(Position, Direction)

    local Bomb = Instance.new("Part")  
    Bomb.Name = "Bomb"  
    Bomb.Shape = Enum.PartType.Block -- Alterado para Bloco/Retângulo
    Bomb.Size = Vector3.new(0.8, 0.6, 1.2) -- Formato retangular 

    Bomb.Position = Position  

    Bomb.Anchored = false  
    Bomb.CanCollide = true  
    Bomb.CanTouch = false  
    Bomb.CanQuery = false  

    Bomb.Material = Enum.Material.SmoothPlastic  
    Bomb.Color = Color3.fromRGB(8, 8, 8)  

    Bomb.CustomPhysicalProperties = PhysicalProperties.new(  
        0.7,  
        0.78,  
        0.15,  
        1,  
        1  
    )  

    Bomb.Parent = workspace  

    --==================================================  
    -- IMPEDIR A BOMBA DE BATER NO PLAYER  
    --==================================================  

    if Character then  
        for _, Part in ipairs(Character:GetDescendants()) do  
            if Part:IsA("BasePart") then  
                local NoCollision = Instance.new("NoCollisionConstraint")  
                NoCollision.Part0 = Bomb  
                NoCollision.Part1 = Part  
                NoCollision.Parent = Bomb  
            end  
        end  
    end  

    --==================================================  
    -- ROLAGEM / IMPULSO
    --==================================================  

    local FlatDirection = Vector3.new(Direction.X, 0, Direction.Z)  

    if FlatDirection.Magnitude < 0.01 then  
        FlatDirection = Vector3.new(0, 0, -1)  
    end  

    FlatDirection = FlatDirection.Unit  

    Bomb.AssemblyLinearVelocity = FlatDirection * 12 + Vector3.new(0, -1, 0)  

    local RollAxis = Vector3.new(0, 1, 0):Cross(FlatDirection)  
    if RollAxis.Magnitude > 0 then  
        Bomb.AssemblyAngularVelocity = RollAxis.Unit * 18  
    end  

    --==================================================  
    -- FREIO  
    --==================================================  

    task.spawn(function()  
        task.wait(0.35)  
        for i = 1, 45 do  
            if not Bomb.Parent then return end  

            local Velocity = Bomb.AssemblyLinearVelocity  
            Bomb.AssemblyLinearVelocity = Vector3.new(  
                Velocity.X * 0.94,  
                Velocity.Y,  
                Velocity.Z * 0.94  
            )  
            Bomb.AssemblyAngularVelocity = Bomb.AssemblyAngularVelocity * 0.94  
            task.wait(0.05)  
        end  
    end)  

    --==================================================  
    -- EXPLOSÃO APÓS EXACTAMENTE 3 SEGUNDOS NO CHÃO
    --==================================================  

    task.delay(3, function()  
        if not Bomb.Parent then return end  

        local ExplosionPosition = Bomb.Position  
        Bomb.Transparency = 1  

        -- Flash  
        local Flash = Instance.new("Part")  
        Flash.Name = "BombFlash"  
        Flash.Shape = Enum.PartType.Ball  
        Flash.Size = Vector3.new(1, 1, 1)  
        Flash.Position = ExplosionPosition  
        Flash.Anchored = true  
        Flash.CanCollide = false  
        Flash.CanTouch = false  
        Flash.CanQuery = false  
        Flash.Material = Enum.Material.Neon  
        Flash.Color = Color3.fromRGB(255, 220, 70)  
        Flash.Transparency = 0.05  
        Flash.Parent = workspace  

        -- Partículas da explosão
        local ParticlePart = Instance.new("Part")  
        ParticlePart.Name = "BombExplosionParticles"  
        ParticlePart.Size = Vector3.new(1, 1, 1)  
        ParticlePart.Position = ExplosionPosition  
        ParticlePart.Anchored = true  
        ParticlePart.CanCollide = false  
        ParticlePart.CanTouch = false  
        ParticlePart.CanQuery = false  
        ParticlePart.Transparency = 1  
        ParticlePart.Parent = workspace  

        local ExplosionParticles = Instance.new("ParticleEmitter")  
        ExplosionParticles.Texture = "rbxasset://textures/particles/sparkles_main.dds"  
        ExplosionParticles.Rate = 0  
        ExplosionParticles.Lifetime = NumberRange.new(0.3, 0.65)  
        ExplosionParticles.Speed = NumberRange.new(8, 22)  
        ExplosionParticles.SpreadAngle = Vector2.new(360, 360)  
        ExplosionParticles.LightEmission = 1  
        ExplosionParticles.Size = NumberSequence.new({  
            NumberSequenceKeypoint.new(0, 0.45),  
            NumberSequenceKeypoint.new(0.25, 0.8),  
            NumberSequenceKeypoint.new(1, 0)  
        })  
        ExplosionParticles.Color = ColorSequence.new(  
            Color3.fromRGB(255, 245, 110),  
            Color3.fromRGB(255, 110, 10)  
        )  
        ExplosionParticles.Parent = ParticlePart  
        ExplosionParticles:Emit(85)  

        task.spawn(function()  
            for i = 1, 12 do  
                if not Flash.Parent then break end  
                local Size = 1 + i * 0.7  
                Flash.Size = Vector3.new(Size, Size, Size)  
                Flash.Transparency = 0.05 + (i / 12) * 0.95  
                task.wait(0.02)  
            end  

            if Flash then  
                Flash:Destroy()  
            end  
        end)  

        Debris:AddItem(ParticlePart, 0.8)  
        Bomb:Destroy()  
    end)  

    return Bomb
end

--==================================================
-- CLIQUE
--==================================================

Tool.Activated:Connect(function()

    if Cooldown then return end  

    if not Character  
        or not Character.Parent  
        or not Humanoid  
        or Humanoid.Health <= 0  
        or not Root  
        or not Root.Parent then  
        return  
    end  

    if Tool.Parent ~= Character then return end  

    -- SÓ PODE ATIVAR CAINDO  
    local State = Humanoid:GetState()  
    local VerticalVelocity = Root.AssemblyLinearVelocity.Y  
    local IsFalling = State == Enum.HumanoidStateType.Freefall and VerticalVelocity < -0.1  

    if not IsFalling then return end  

    Cooldown = true  

    -- PULO IMEDIATO
    local CurrentVelocity = Root.AssemblyLinearVelocity  
    local JumpVelocity  

    if Humanoid.UseJumpPower then  
        JumpVelocity = Humanoid.JumpPower  
    else  
        JumpVelocity = math.sqrt(2 * workspace.Gravity * Humanoid.JumpHeight)  
    end  

    Root.AssemblyLinearVelocity = Vector3.new(  
        CurrentVelocity.X,  
        JumpVelocity,  
        CurrentVelocity.Z  
    )  

    -- POSIÇÃO: NOS PÉS  
    local FeetPosition = Root.Position - Vector3.new(0, 2.6, 0)  
    local BombPosition = FeetPosition + Vector3.new(0, 0.45, 0)  
    local Direction = Root.CFrame.LookVector  

    -- CRIA A BOMBA
    CreateBomb(BombPosition, Direction)  

    task.delay(3, function()  
        Cooldown = false  
    end)

end)
