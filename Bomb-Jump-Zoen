--==================================================
-- TOOL HOLD ANIMATIONS
--==================================================

local ToolHoldAnims = {
	-- R15
	["rbxassetid://507768375"] = true,
	["rbxassetid://507768133"] = true,
	["rbxassetid://522635514"] = true,
	["rbxassetid://522638767"] = true,

	-- R6
	["rbxassetid://182386253"] = true,
	["rbxassetid://182386221"] = true,
	["rbxassetid://182386188"] = true,
	["rbxassetid://182386147"] = true,
}

local ToolAnimConnection = nil

local function DisconnectToolAnimBlock()
	if ToolAnimConnection then
		ToolAnimConnection:Disconnect()
		ToolAnimConnection = nil
	end
end

local function StopToolAnimations()
	if not Animator then
		return
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
		local Animation = Track.Animation

		if Animation and ToolHoldAnims[Animation.AnimationId] then
			Track:Stop(0)
		end
	end
end

local function StartToolAnimBlock()
	if not Humanoid or not Humanoid.Parent then
		return
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	DisconnectToolAnimBlock()

	StopToolAnimations()

	ToolAnimConnection = Animator.AnimationPlayed:Connect(function(Track)
		local Animation = Track.Animation

		if not Animation then
			return
		end

		if ToolHoldAnims[Animation.AnimationId] then
			Track:Stop(0)
		end
	end)

	task.defer(function()
		StopToolAnimations()
	end)
end

--==================================================
-- CHARACTER
--==================================================

local function SetupCharacter(Char)
	Character = Char
	Humanoid = Char:WaitForChild("Humanoid")
	Root = Char:WaitForChild("HumanoidRootPart")
	Animator = Humanoid:FindFirstChildOfClass("Animator")
	Cooldown = false
end

SetupCharacter(Player.Character or Player.CharacterAdded:Wait())

Player.CharacterAdded:Connect(function(Char)
	DisconnectToolAnimBlock()
	SetupCharacter(Char)
end)

