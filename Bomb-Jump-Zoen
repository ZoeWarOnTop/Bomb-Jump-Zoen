	Beep.Name = "FastWhistle"
	Beep.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	Beep.Volume = 0.8
	Beep.PlaybackSpeed = 1.35
	Beep.RollOffMaxDistance = 35
	Beep.RollOffMinDistance = 5
	Beep.Parent = Whistle

	return Whistle, Light, Beep
end

