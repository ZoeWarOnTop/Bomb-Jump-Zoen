	Whistle.CanCollide = false
	Whistle.CanTouch = false
	Whistle.CanQuery = false
	Whistle.Massless = true
	Whistle.Parent = Parent

	local WeldWhistle = Instance.new("WeldConstraint")
	WeldWhistle.Part0 = MainPart
	WeldWhistle.Part1 = Whistle
	WeldWhistle.Parent = Whistle

	local Light = Instance.new("PointLight")

	Light.Name = "RedLight"
	Light.Color = Color3.fromRGB(255, 0, 0)
	Light.Brightness = 2
	Light.Range = 4
	Light.Enabled = false
