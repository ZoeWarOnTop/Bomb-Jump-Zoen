	Tool.RequiresHandle = false
	Tool.CanBeDropped = false
	Tool.ManualActivationOnly = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if Cooldown then return end
		if not Character or not Humanoid or Humanoid.Health <= 0 or not Root or not Root.Parent then return end
		if Tool.Parent ~= Character then return end

		Cooldown = true

		-- ATIVA ESTADO E ANIMAÇÃO DE PULO
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

		-- PULO IMEDIATO
		local CurrentVelocity = Root.AssemblyLinearVelocity
		local JumpVelocity = Humanoid.UseJumpPower and Humanoid.JumpPower or math.sqrt(2 * workspace.Gravity * Humanoid.JumpHeight)

		Root.AssemblyLinearVelocity = Vector3.new(CurrentVelocity.X, JumpVelocity, CurrentVelocity.Z)

		-- CRIAÇÃO DA BOMBA RETÂNGULAR
		local FeetPosition = Root.Position - Vector3.new(0, 2.6, 0)
		local BombPosition = FeetPosition + Vector3.new(0, 0.45, 0)

		local Bomb = Instance.new("Part")
		Bomb.Name = "Bomb"
		Bomb.Shape = Enum.PartType.Block
		Bomb.Size = Vector3.new(0.8, 0.6, 1.2)
		Bomb.Position = BombPosition
		Bomb.Anchored = false
		Bomb.CanCollide = true
		Bomb.CanTouch = true
		Bomb.CanQuery = false
		Bomb.Material = Enum.Material.SmoothPlastic
		Bomb.Color = bombColor
		Bomb.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.78, 0.15, 1, 1)
		Bomb.Parent = workspace

		-- NO COLLISION COM O PLAYER
		if Character then
			for _, Part in ipairs(Character:GetDescendants()) do
				if Part:IsA("BasePart") then
					local NoCollision = Instance.new("NoCollisionConstraint")
					NoCollision.Part0 = Bomb
					NoCollision.Part1 = Part
					NoCollision.Parent = Bomb
				end
			end
		end

		-- TOQUE NO CHÃO -> EXPLOSÃO APÓS 3 SEGUNDOS
		local Exploded = false
		local TouchConnection

		TouchConnection = Bomb.Touched:Connect(function(Hit)
			if Exploded or not Bomb.Parent then return end
			if not Hit or not Hit:IsA("BasePart") then return end
			if Character and Hit:IsDescendantOf(Character) then return end

			Exploded = true

			task.delay(3, function()
				if not Bomb.Parent then return end
				if TouchConnection then TouchConnection:Disconnect() end

				local ExplosionPosition = Bomb.Position
				Bomb.Transparency = 1

				-- FLASH
				local Flash = Instance.new("Part")
				Flash.Name = "BombFlash"
				Flash.Shape = Enum.PartType.Ball
				Flash.Size = Vector3.new(1, 1, 1)
				Flash.Position = ExplosionPosition
				Flash.Anchored = true
				Flash.CanCollide = false
				Flash.CanTouch = false
				Flash.CanQuery = false
				Flash.Material = Enum.Material.Neon
				Flash.Color = bombColor
				Flash.Transparency = 0.05
				Flash.Parent = workspace

				-- PARTICULAS DA EXPLOSÃO
				local ParticlePart = Instance.new("Part")
				ParticlePart.Name = "BombExplosionParticles"
				ParticlePart.Size = Vector3.new(1, 1, 1)
				ParticlePart.Position = ExplosionPosition
				ParticlePart.Anchored = true
				ParticlePart.CanCollide = false
				ParticlePart.CanTouch = false
				ParticlePart.CanQuery = false
				ParticlePart.Transparency = 1
				ParticlePart.Parent = workspace

				local ExplosionParticles = Instance.new("ParticleEmitter")
				ExplosionParticles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				ExplosionParticles.Rate = 0
				ExplosionParticles.Lifetime = NumberRange.new(0.3, 0.65)
				ExplosionParticles.Speed = NumberRange.new(8, 22)
				ExplosionParticles.SpreadAngle = Vector2.new(360, 360)
				ExplosionParticles.LightEmission = 1
				ExplosionParticles.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.45),
					NumberSequenceKeypoint.new(0.25, 0.8),
					NumberSequenceKeypoint.new(1, 0)
				})
				ExplosionParticles.Color = ColorSequence.new(bombColor)
				ExplosionParticles.Parent = ParticlePart
				ExplosionParticles:Emit(85)

				task.spawn(function()
					for i = 1, 12 do
						if not Flash.Parent then break end
						local Size = 1 + i * 0.7
						Flash.Size = Vector3.new(Size, Size, Size)
						Flash.Transparency = 0.05 + (i / 12) * 0.95
						task.wait(0.02)
					end
					if Flash then Flash:Destroy() end
				end)

				Debris:AddItem(ParticlePart, 0.8)
				Bomb:Destroy()
			end)
		end)

		task.delay(Config.Cooldown, function()
			Cooldown = false
		end)
	end)
end

--==================================================
-- CLIQUE NO BIG BUTTON AUTO BJ
--==================================================

BigButton.MouseButton1Click:Connect(function()
	if WasDragged then
		WasDragged = false
		return
	end

	if not Character or not Humanoid or Humanoid.Health <= 0 or not Tool or not Tool.Parent then return end

	-- 1. Equipar a bomba
	if Tool.Parent ~= Character then
		Humanoid:EquipTool(Tool)
		task.wait()
	end

	-- 2. Ativar bomba
	if Tool.Parent == Character then
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		Tool:Activate()
		task.wait(0.12)
	end

	-- 3. Desequipar
	if Humanoid and Humanoid.Parent then
		Humanoid:UnequipTools()
	end
end)

--==================================================
-- SETUP RESPAWN PERSISTENTE
--==================================================

local function SetupCharacter(Char)
	Character = Char
	Humanoid = Char:WaitForChild("Humanoid")
	Root = Char:WaitForChild("HumanoidRootPart")
	Cooldown = false
	GiveTool()
end

if Player.Character then
	SetupCharacter(Player.Character)
end

Player.CharacterAdded:Connect(function(Char)
	SetupCharacter(Char)
end)
