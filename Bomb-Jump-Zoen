--// ANIMATION BLOCK

local function stopEquipAnimation()
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		return
	end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animation = track.Animation

		if animation then
			local id = animation.AnimationId:lower()

			if id:find("equip")
				or id:find("tool")
				or id:find("hold") then

				track:Stop(0)
			end
		end
	end
end

local function keepArmDown()
	if not character then
		return
	end

	local torso =
		character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")

	if not torso then
		return
	end

	local shoulder =
		torso:FindFirstChild("Right Shoulder")
		or torso:FindFirstChild("RightShoulder")

	if shoulder and shoulder:IsA("Motor6D") then
		shoulder.Transform = CFrame.new()
	end
end

--// BOMB

local function createBomb(position, direction)
	local bomb = Instance.new("Part")

	bomb.Name = "ZoeWarBlackBomb"
	bomb.Size = Vector3.new(2.8, 0.8, 1.6)
	bomb.CFrame = CFrame.new(position)

	bomb.Color = Color3.fromRGB(0, 0, 0)
	bomb.Material = Enum.Material.SmoothPlastic

	bomb.TopSurface = Enum.SurfaceType.Smooth
	bomb.BottomSurface = Enum.SurfaceType.Smooth

	bomb.Anchored = false
	bomb.CanCollide = true
	bomb.CanTouch = true
	bomb.CanQuery = true
	bomb.Massless = false

	bomb.Parent = workspace

	bomb.AssemblyLinearVelocity =
		direction.Unit * THROW_FORCE
		+ Vector3.new(0, 8, 0)

	local exploded = false

	local connection

	connection = bomb.Touched:Connect(function(hit)
		if exploded then
			return
		end

		if not bomb.Parent then
			if connection then
				connection:Disconnect()
			end

			return
		end

		exploded = true

		local explosion = Instance.new("Explosion")

		explosion.Position = bomb.Position
		explosion.BlastRadius = 0
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0

		explosion.Parent = workspace

		if connection then
			connection:Disconnect()
		end

		bomb:Destroy()
	end)

	Debris:AddItem(bomb, BOMB_LIFETIME)
end

local function canThrow()
	return os.clock() - lastThrow >= cooldownTime
end

local function throwBomb()
	if not equipped then
		return
	end

	if throwing then
		return
	end

	if not canThrow() then
		return
	end

	updateCharacter()

	if not character or not humanoid or not root then
		return
	end

	throwing = true
	lastThrow = os.clock()

	stopEquipAnimation()
	keepArmDown()

	local direction = root.CFrame.LookVector

	local spawnPosition =
		root.Position
		+ direction * 2.5
		+ Vector3.new(0, -0.5, 0)

	createBomb(spawnPosition, direction)

	task.delay(cooldownTime, function()
		throwing = false
	end)
end

