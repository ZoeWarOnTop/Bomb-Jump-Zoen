--==================================================
-- STOP TOOL ANIMATION
--==================================================

local function StopToolAnimation()

	if not Humanoid then
		return
	end

	local Animator =
		Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	for _, Track in ipairs(
		Animator:GetPlayingAnimationTracks()
	) do

		local Animation = Track.Animation

		if Animation then

			local ID =
				Animation.AnimationId:lower()

			if ID:find("tool")
				or ID:find("equip")
				or ID:find("hold")
				or ID:find("toolnone") then

				Track:Stop(0)

			end

		end

	end

end

--==================================================
-- KEEP RIGHT ARM DOWN
--==================================================

local function KeepArmDown()

	if not Character then
		return
	end

	local Torso =
		Character:FindFirstChild("Torso")

	if Torso then

		local Shoulder =
			Torso:FindFirstChild("Right Shoulder")

		if Shoulder
			and Shoulder:IsA("Motor6D") then

			Shoulder.Transform =
				CFrame.new()

		end

	end

	local UpperTorso =
		Character:FindFirstChild("UpperTorso")

	if UpperTorso then

		local Shoulder =
			UpperTorso:FindFirstChild("RightShoulder")
			or UpperTorso:FindFirstChild("Right Shoulder")

		if Shoulder
			and Shoulder:IsA("Motor6D") then

			Shoulder.Transform =
				CFrame.new()

		end

	end

end

