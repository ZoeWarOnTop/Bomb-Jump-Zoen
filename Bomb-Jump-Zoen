local DraggingMenu = false
local DragInputMenu, DragStartMenu, StartPosMenu

MenuFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		DraggingMenu = true
		DragStartMenu = input.Position
		StartPosMenu = MenuFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				DraggingMenu = false
			end
		end)
	end
end)

MenuFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		DragInputMenu = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == DragInputMenu and DraggingMenu then
		local delta = input.Position - DragStartMenu
		MenuFrame.Position = UDim2.new(StartPosMenu.X.Scale, StartPosMenu.X.Offset + delta.X, StartPosMenu.Y.Scale, StartPosMenu.Y.Offset + delta.Y)
		SavedPosition = MenuFrame.Position -- Atualiza a posição salva para onde foi arrastada
	end
end)

