--==================================================
-- CREATE BOMB
--==================================================

local function CreateBomb(Position, Direction)

	local Bomb = Instance.new("Part")

	Bomb.Name = "Bomb"

	-- Black rectangular bomb.
	Bomb.Size =
		Vector3.new(
			1.45,
			0.75,
			1.05
		)

	Bomb.CFrame =
		CFrame.lookAt(
			Position,
			Position + Direction
		)

	Bomb.Anchored = false
	Bomb.CanCollide = true
	Bomb.CanTouch = true
	Bomb.CanQuery = false

	Bomb.Material =
		Enum.Material.SmoothPlastic

	Bomb.Color =
		Color3.fromRGB(
			8,
			8,
			8
		)

	Bomb.CustomPhysicalProperties =
		PhysicalProperties.new(
			0.7,
			0.78,
			0.15,
			1,
			1
		)

	Bomb.Parent = workspace

	--==================================================
	-- NO COLLISION WITH PLAYER
	--==================================================

	if Character then

		for _, Part in ipairs(
			Character:GetDescendants()
		) do

			if Part:IsA("BasePart") then

				local NoCollision =
					Instance.new(
						"NoCollisionConstraint"
					)

				NoCollision.Part0 = Bomb
				NoCollision.Part1 = Part
				NoCollision.Parent = Bomb

			end

		end

	end

	--==================================================
	-- FUSE
	--==================================================

	local Fuse = Instance.new("Part")

	Fuse.Name = "Fuse"

	Fuse.Size =
		Vector3.new(
			0.075,
			0.48,
			0.075
		)

	Fuse.Color =
		Color3.fromRGB(
			70,
			42,
			20
		)

	Fuse.Material =
		Enum.Material.SmoothPlastic

	Fuse.CanCollide = false
	Fuse.CanTouch = false
	Fuse.CanQuery = false
	Fuse.Massless = true

	Fuse.CFrame =
		Bomb.CFrame *
		CFrame.new(
			0,
			0.52,
			0
		)

	Fuse.Parent = Bomb

	local FuseWeld =
		Instance.new("WeldConstraint")

	FuseWeld.Part0 = Bomb
	FuseWeld.Part1 = Fuse
	FuseWeld.Parent = Fuse

	--==================================================
	-- LIGHT
	--==================================================

	local FuseLight =
		Instance.new("PointLight")

	FuseLight.Name =
		"FuseLight"

	FuseLight.Color =
		Color3.fromRGB(
			255,
			120,
			20
		)

	FuseLight.Brightness = 0
	FuseLight.Range = 3

	FuseLight.Parent = Fuse

	--==================================================
	-- FLAME
	--==================================================

	local Flame =
		Instance.new("ParticleEmitter")

	Flame.Name =
		"FuseFlame"

	Flame.Texture =
		"rbxasset://textures/particles/fire_main.dds"

	Flame.Rate = 0

	Flame.Lifetime =
		NumberRange.new(
			0.12,
			0.25
		)

	Flame.Speed =
		NumberRange.new(
			0.5,
			1.5
		)

	Flame.LightEmission = 1

	Flame.Size =
		NumberSequence.new({
			NumberSequenceKeypoint.new(
				0,
				0.25
			),

			NumberSequenceKeypoint.new(
				0.5,
				0.18
			),

			NumberSequenceKeypoint.new(
				1,
				0
			)
		})

	Flame.Color =
		ColorSequence.new(
			Color3.fromRGB(
				255,
				240,
				100
			),

			Color3.fromRGB(
				255,
				80,
				10
			)
		)

	Flame.Parent = Fuse

	--==================================================
	-- ROLLING
	--==================================================

	local FlatDirection =
		Vector3.new(
			Direction.X,
			0,
			Direction.Z
		)

	if FlatDirection.Magnitude < 0.01 then

		FlatDirection =
			Vector3.new(
				0,
				0,
				-1
			)

	end

	FlatDirection =
		FlatDirection.Unit

	Bomb.AssemblyLinearVelocity =
		FlatDirection * 12 +
		Vector3.new(
			0,
			-1,
			0
		)

	local RollAxis =
		Vector3.new(
			0,
			1,
			0
		):Cross(
			FlatDirection
		)

	if RollAxis.Magnitude > 0 then

		Bomb.AssemblyAngularVelocity =
			RollAxis.Unit * 18

	end

	--==================================================
	-- BRAKE
	--==================================================

	task.spawn(function()

		task.wait(0.35)

		for i = 1, 45 do

			if not Bomb.Parent then
				return
			end

			local Velocity =
				Bomb.AssemblyLinearVelocity

			Bomb.AssemblyLinearVelocity =
				Vector3.new(
					Velocity.X * 0.94,
					Velocity.Y,
					Velocity.Z * 0.94
				)

			Bomb.AssemblyAngularVelocity =
				Bomb.AssemblyAngularVelocity * 0.94

			task.wait(0.05)

		end

	end)

	--==================================================
	-- GROUND DETECTION
	--==================================================

	local Grounded = false
	local Exploded = false
	local GroundConnection

	local function Explode()

		if Exploded
			or not Bomb.Parent then

			return
		end

		Exploded = true

		if GroundConnection then

			GroundConnection:Disconnect()
			GroundConnection = nil

		end

		local ExplosionPosition =
			Bomb.Position

		Bomb.Transparency = 1
		Fuse.Transparency = 1

		Flame.Enabled = false
		FuseLight.Enabled = false

		--==================================================
		-- VISUAL FLASH ONLY
		--==================================================

		local Flash =
			Instance.new("Part")

		Flash.Name =
			"BombFlash"

		Flash.Shape =
			Enum.PartType.Ball

		Flash.Size =
			Vector3.new(
				1,
				1,
				1
			)

		Flash.Position =
			ExplosionPosition

		Flash.Anchored = true
		Flash.CanCollide = false
		Flash.CanTouch = false
		Flash.CanQuery = false

		Flash.Material =
			Enum.Material.Neon

		Flash.Color =
			Color3.fromRGB(
				255,
				220,
				70
			)

		Flash.Transparency = 0.05

		Flash.Parent = workspace

		--==================================================
		-- VISUAL EXPLOSION PARTICLES ONLY
		--==================================================

		local ParticlePart =
			Instance.new("Part")

		ParticlePart.Name =
			"BombExplosionParticles"

		ParticlePart.Size =
			Vector3.new(
				1,
				1,
				1
			)

		ParticlePart.Position =
			ExplosionPosition

		ParticlePart.Anchored = true
		ParticlePart.CanCollide = false
		ParticlePart.CanTouch = false
		ParticlePart.CanQuery = false
		ParticlePart.Transparency = 1

		ParticlePart.Parent = workspace

		local ExplosionParticles =
			Instance.new("ParticleEmitter")

		ExplosionParticles.Texture =
			"rbxasset://textures/particles/sparkles_main.dds"

		ExplosionParticles.Rate = 0

		ExplosionParticles.Lifetime =
			NumberRange.new(
				0.3,
				0.65
			)

		ExplosionParticles.Speed =
			NumberRange.new(
				8,
				22
			)

		ExplosionParticles.SpreadAngle =
			Vector2.new(
				360,
				360
			)

		ExplosionParticles.LightEmission = 1

		ExplosionParticles.Size =
			NumberSequence.new({
				NumberSequenceKeypoint.new(
					0,
					0.45
				),

				NumberSequenceKeypoint.new(
					0.25,
					0.8
				),

				NumberSequenceKeypoint.new(
					1,
					0
				)
			})

		ExplosionParticles.Color =
			ColorSequence.new(
				Color3.fromRGB(
					255,
					245,
					110
				),

				Color3.fromRGB(
					255,
					110,
					10
				)
			)

		ExplosionParticles.Parent =
			ParticlePart

		ExplosionParticles:Emit(85)

		--==================================================
		-- IMPORTANT:
		-- NO Roblox Explosion object is created.
		-- Therefore there is no damage, force,
		-- knockback, ragdoll or physical effect.
		--==================================================

		task.spawn(function()

			for i = 1, 12 do

				if not Flash.Parent then
					break
				end

				local Size =
					1 + i * 0.7

				Flash.Size =
					Vector3.new(
						Size,
						Size,
						Size
					)

				Flash.Transparency =
					0.05 +
					(i / 12) * 0.95

				task.wait(0.02)

			end

			if Flash then
				Flash:Destroy()
			end

		end)

		Debris:AddItem(
			ParticlePart,
			0.8
		)

		Bomb:Destroy()

	end

	--==================================================
	-- TOUCH GROUND
	--==================================================

	GroundConnection =
		Bomb.Touched:Connect(function(Hit)

			if Grounded
				or Exploded
				or not Bomb.Parent then

				return
			end

			if not Hit
				or not Hit:IsA("BasePart") then

				return
			end

			if Character
				and Hit:IsDescendantOf(Character) then

				return
			end

			Grounded = true

			-- Exactly 3 seconds after touching the ground.
			task.delay(3, function()

				if Bomb.Parent
					and Grounded
					and not Exploded then

					Explode()

				end

			end)

		end)

	Debris:AddItem(
		Bomb,
		15
	)

	return Bomb
end

--==================================================
-- TOOL ACTIVATION
--==================================================

local function BombJump()

	if Cooldown then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		return
	end

	if Tool.Parent ~= Character then
		return
	end

	--==================================================
	-- ONLY WHILE FALLING
	--==================================================

	local State =
		Humanoid:GetState()

	local VerticalVelocity =
		Root.AssemblyLinearVelocity.Y

	local IsFalling =
		State == Enum.HumanoidStateType.Freefall
		and VerticalVelocity < -0.1

	if not IsFalling then
		return
	end

	Cooldown = true

	--==================================================
	-- IMMEDIATE JUMP
	--==================================================

	local CurrentVelocity =
		Root.AssemblyLinearVelocity

	local JumpVelocity

	if Humanoid.UseJumpPower then

		JumpVelocity =
			Humanoid.JumpPower

	else

		JumpVelocity =
			math.sqrt(
				2 *
				workspace.Gravity *
				Humanoid.JumpHeight
			)

	end

	Root.AssemblyLinearVelocity =
		Vector3.new(
			CurrentVelocity.X,
			JumpVelocity,
			CurrentVelocity.Z
		)

	--==================================================
	-- HANDLE STAYS INVISIBLE
	--==================================================

	Handle.Transparency = 1

	--==================================================
	-- BOMB AT FEET
	--==================================================

	local FeetPosition =
		Root.Position -
		Vector3.new(
			0,
			2.6,
			0
		)

	local BombPosition =
		FeetPosition +
		Vector3.new(
			0,
			0.45,
			0
		)

	local Direction =
		Root.CFrame.LookVector

	CreateBomb(
		BombPosition,
		Direction
	)

	Handle.Transparency = 1

	task.delay(
		Config.Cooldown,
		function()

			Cooldown = false

		end
	)

end

Tool.Activated:Connect(
	BombJump
)

