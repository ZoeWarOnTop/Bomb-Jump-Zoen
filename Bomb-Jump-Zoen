local draggingSV = false
local function updateSV(inputObj)
	local pos = SatValPicker.AbsolutePosition
	local size = SatValPicker.AbsoluteSize
	local x = math.clamp((inputObj.Position.X - pos.X) / size.X, 0, 1)
	local y = math.clamp((inputObj.Position.Y - pos.Y) / size.Y, 0, 1)

	currentS = x
	currentV = 1 - y
	SVCursor.Position = UDim2.new(x, 0, y, 0)
	updateColorOutput()
end

SatValPicker.InputBegan:Connect(function(inputObj)
	if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
		draggingSV = true
		updateSV(inputObj)
	end
end)

local draggingHue = false
local function updateHue(inputObj)
	local pos = HuePicker.AbsolutePosition
	local size = HuePicker.AbsoluteSize
	local y = math.clamp((inputObj.Position.Y - pos.Y) / size.Y, 0, 1)

	currentH = y
	HueCursor.Position = UDim2.new(0.5, 0, y, 0)
	updateColorOutput()
end

HuePicker.InputBegan:Connect(function(inputObj)
	if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
		draggingHue = true
		updateHue(inputObj)
	end
end)

UserInputService.InputEnded:Connect(function(inputObj)
	if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
		draggingSV = false
		draggingHue = false
	end
end)

UserInputService.InputChanged:Connect(function(inputObj)
	if (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
		if draggingSV then updateSV(inputObj) end
		if draggingHue then updateHue(inputObj) end
	end
end)

HexBox.FocusLost:Connect(function()
	local text = HexBox.Text:gsub("#", "")
	local success, color = pcall(function() return Color3.fromHex(text) end)
	if success and color then
		local h, s, v = color:ToHSV()
		currentH, currentS, currentV = h, s, v
		SVCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		HueCursor.Position = UDim2.new(0.5, 0, h, 0)
		updateColorOutput()
	end
end)

updateColorOutput()

