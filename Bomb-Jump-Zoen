-- ARRASTE DO BIG BUTTON
local DraggingBig = false
local DragInputBig, DragStartBig, StartPositionBig
local WasDragged = false

local function UpdateBigButton(InputObj)
	if not BigButtonUnlocked then return end
	local Delta = InputObj.Position - DragStartBig
	if Delta.Magnitude > 5 then WasDragged = true end

	BigButton.Position = UDim2.new(
		StartPositionBig.X.Scale, StartPositionBig.X.Offset + Delta.X,
		StartPositionBig.Y.Scale, StartPositionBig.Y.Offset + Delta.Y
	)

	LockButton.Position = UDim2.new(
		BigButton.Position.X.Scale, BigButton.Position.X.Offset + 130,
		BigButton.Position.Y.Scale, BigButton.Position.Y.Offset + 39
	)
end

BigButton.InputBegan:Connect(function(InputObj)
	if not BigButtonUnlocked then return end
	if InputObj.UserInputType == Enum.UserInputType.MouseButton1 or InputObj.UserInputType == Enum.UserInputType.Touch then
		DraggingBig = true
		WasDragged = false
		DragStartBig = InputObj.Position
		StartPositionBig = BigButton.Position
		DragInputBig = InputObj
	end
end)

BigButton.InputChanged:Connect(function(InputObj)
	if InputObj.UserInputType == Enum.UserInputType.MouseMovement or InputObj.UserInputType == Enum.UserInputType.Touch then
		DragInputBig = InputObj
	end
end)

UserInputService.InputChanged:Connect(function(InputObj)
	if DraggingBig and BigButtonUnlocked and InputObj == DragInputBig then
		UpdateBigButton(InputObj)
	end
end)

UserInputService.InputEnded:Connect(function(InputObj)
	if InputObj == DragInputBig then
		DraggingBig = false
		DragInputBig = nil
	end
end)

