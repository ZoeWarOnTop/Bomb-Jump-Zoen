--==================================================
-- KEEP ARM DOWN
--==================================================

local function KeepArmDown()
	if not Character then
		return
	end

	local Torso = Character:FindFirstChild("Torso")

	if Torso then
		local Shoulder = Torso:FindFirstChild("Right Shoulder")

		if Shoulder and Shoulder:IsA("Motor6D") then
			Shoulder.Transform = CFrame.new()
			Shoulder.C0 = CFrame.new(Shoulder.C0.Position)
		end
	end

	local UpperTorso = Character:FindFirstChild("UpperTorso")

	if UpperTorso then
		local Shoulder =
			UpperTorso:FindFirstChild("RightShoulder")
			or UpperTorso:FindFirstChild("Right Shoulder")

		if Shoulder and Shoulder:IsA("Motor6D") then
			Shoulder.Transform = CFrame.new()
		end
	end
end

--==================================================
-- STOP TOOL ANIMATIONS
--==================================================

local function StopToolAnimations()
	if not Humanoid then
		return
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
		local Animation = Track.Animation

		if Animation then
			local ID = Animation.AnimationId:lower()

			if ID:find("tool")
				or ID:find("equip")
				or ID:find("hold")
				or ID:find("idle") then

				Track:Stop(0)
			end
		end
	end
end

--==================================================
-- CREATE BOMB
--==================================================

local function CreateBomb()
	if not Root or not Root.Parent then
		return
	end

	local Bomb = Instance.new("Part")

	Bomb.Name = "ZoeWarBomb"
	Bomb.Size = Vector3.new(2.8, 0.85, 1.6)

	Bomb.CFrame =
		Root.CFrame
		* CFrame.new(0, -3.2, 0)

	Bomb.Anchored = true
	Bomb.CanCollide = false
	Bomb.CanTouch = false
	Bomb.CanQuery = false

	Bomb.Material = Enum.Material.SmoothPlastic
	Bomb.Color = Color3.fromRGB(0, 0, 0)

	Bomb.Parent = workspace

	Debris:AddItem(Bomb, Config.ExplosionDelay + 2)

	task.delay(Config.ExplosionDelay, function()
		if not Bomb.Parent then
			return
		end

		local ExplosionPosition = Bomb.Position

		Bomb:Destroy()

		-- Explosion with no physical effect.
		local Explosion = Instance.new("Explosion")
		Explosion.Position = ExplosionPosition
		Explosion.BlastRadius = 0
		Explosion.BlastPressure = 0
		Explosion.DestroyJointRadiusPercent = 0
		Explosion.Parent = workspace

		-- Manual Bomb Jump.
		if Character
			and Character.Parent
			and Humanoid
			and Humanoid.Health > 0
			and Root
			and Root.Parent then

			Root.AssemblyLinearVelocity = Vector3.new(
				Root.AssemblyLinearVelocity.X,
				Config.JumpPower,
				Root.AssemblyLinearVelocity.Z
			)
		end
	end)
end

--==================================================
-- BOMB JUMP
--==================================================

local function BombJump()
	if Cooldown then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		return
	end

	if Tool.Parent ~= Character then
		return
	end

	Cooldown = true

	StopToolAnimations()
	KeepArmDown()

	CreateBomb()

	task.delay(Config.Cooldown, function()
		Cooldown = false
	end)
end

--==================================================
-- TOOL
--==================================================

Tool.Activated:Connect(function()
	BombJump()
end)

Tool.Equipped:Connect(function()
	StopToolAnimations()
	KeepArmDown()

	task.defer(function()
		StopToolAnimations()
		KeepArmDown()
	end)
end)

