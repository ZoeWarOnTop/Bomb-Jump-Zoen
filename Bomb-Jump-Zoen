--==================================================
-- CREATE DROPPED C4
--==================================================

local function CreateBomb(Position)

	local Model = Instance.new("Model")
	Model.Name = "FakeC4Bomb"

	local Bomb = Instance.new("Part")

	Bomb.Name = "Bomb"
	Bomb.Size = Vector3.new(1.45, 0.42, 0.9)
	Bomb.CFrame = CFrame.new(Position)

	Bomb.Anchored = false
	Bomb.CanCollide = true
	Bomb.CanTouch = true
	Bomb.CanQuery = false

	Bomb.Material = Enum.Material.SmoothPlastic
	Bomb.Color = Color3.fromRGB(255, 255, 255)

	Bomb.CustomPhysicalProperties = PhysicalProperties.new(
		0.7,
		0.78,
		0.15,
		1,
		1
	)

	local BombMesh = Instance.new("SpecialMesh")
	BombMesh.MeshType = Enum.MeshType.FileMesh
	BombMesh.MeshId = C4_MESH_ID
	BombMesh.Scale = Vector3.new(1, 1, 1)
	BombMesh.Parent = Bomb

	Bomb.Parent = Model

	local Whistle, Light, Beep =
		AddC4Effects(Model, Bomb)

	Model.PrimaryPart = Bomb
	Model.Parent = workspace

	--==================================================
	-- NO COLLISION WITH PLAYER
	--==================================================

	if Character then

		for _, Part in ipairs(Character:GetDescendants()) do

			if Part:IsA("BasePart") then

				local NoCollision =
					Instance.new("NoCollisionConstraint")

				NoCollision.Part0 = Bomb
				NoCollision.Part1 = Part
				NoCollision.Parent = Bomb

			end

		end

	end

	--==================================================
	-- FAST RED WHISTLE
	--==================================================

	task.spawn(function()

		while Model.Parent do

			Light.Enabled = true
			Whistle.Transparency = 0

			Beep:Play()

			task.wait(0.11)

			if not Model.Parent then
				break
			end

			Light.Enabled = false
			Whistle.Transparency = 0.65

			task.wait(0.11)

		end

	end)

	--==================================================
	-- EXPLOSION
	--==================================================

	local Exploded = false
	local TouchConnection

	local function Explode()

		if Exploded or not Model.Parent then
			return
		end

		Exploded = true

		if TouchConnection then
			TouchConnection:Disconnect()
			TouchConnection = nil
		end

		local ExplosionPosition = Bomb.Position

		Model:Destroy()

		--==================================================
		-- FLASH
		--==================================================

		local Flash = Instance.new("Part")

		Flash.Name = "BombFlash"
		Flash.Shape = Enum.PartType.Ball
		Flash.Size = Vector3.new(1, 1, 1)
		Flash.Position = ExplosionPosition

		Flash.Anchored = true
		Flash.CanCollide = false
		Flash.CanTouch = false
		Flash.CanQuery = false

		Flash.Material = Enum.Material.Neon
		Flash.Color = Color3.fromRGB(255, 220, 70)
		Flash.Transparency = 0.05

		Flash.Parent = workspace

		--==================================================
		-- PARTICLES
		--==================================================

		local ParticlePart = Instance.new("Part")

		ParticlePart.Name = "BombExplosionParticles"
		ParticlePart.Size = Vector3.new(1, 1, 1)
		ParticlePart.Position = ExplosionPosition

		ParticlePart.Anchored = true
		ParticlePart.CanCollide = false
		ParticlePart.CanTouch = false
		ParticlePart.CanQuery = false

		ParticlePart.Transparency = 1
		ParticlePart.Parent = workspace

		local ExplosionParticles = Instance.new("ParticleEmitter")

		ExplosionParticles.Texture =
			"rbxasset://textures/particles/sparkles_main.dds"

		ExplosionParticles.Rate = 0
		ExplosionParticles.Lifetime = NumberRange.new(0.3, 0.65)
		ExplosionParticles.Speed = NumberRange.new(8, 22)
		ExplosionParticles.SpreadAngle = Vector2.new(360, 360)
		ExplosionParticles.LightEmission = 1

		ExplosionParticles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.25, 0.8),
			NumberSequenceKeypoint.new(1, 0)
		})

		ExplosionParticles.Color = ColorSequence.new(
			Color3.fromRGB(255, 245, 110),
			Color3.fromRGB(255, 110, 10)
		)

		ExplosionParticles.Parent = ParticlePart
		ExplosionParticles:Emit(85)

		task.spawn(function()

			for i = 1, 12 do

				if not Flash.Parent then
					break
				end

				local Size = 1 + i * 0.7

				Flash.Size = Vector3.new(
					Size,
					Size,
					Size
				)

				Flash.Transparency =
					0.05 + (i / 12) * 0.95

				task.wait(0.02)

			end

			if Flash then
				Flash:Destroy()
			end

		end)

		Debris:AddItem(ParticlePart, 0.8)
	end

	--==================================================
	-- GROUND TOUCH
	--==================================================

	TouchConnection = Bomb.Touched:Connect(function(Hit)

		if Exploded or not Model.Parent then
			return
		end

		if not Hit or not Hit:IsA("BasePart") then
			return
		end

		if Character and Hit:IsDescendantOf(Character) then
			return
		end

		Exploded = true

		task.delay(1, function()

			if not Model.Parent then
				return
			end

			Exploded = false
			Explode()

		end)

	end)

	return Model
end

--==================================================
-- ACTIVATION
--==================================================

Tool.Activated:Connect(function()

	if Cooldown then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then
		return
	end

	if Tool.Parent ~= Character then
		return
	end

	local State = Humanoid:GetState()
	local VerticalVelocity = Root.AssemblyLinearVelocity.Y

	local IsFalling =
		State == Enum.HumanoidStateType.Freefall
		and VerticalVelocity < -0.1

	if not IsFalling then
		return
	end

	Cooldown = true

	--==================================================
	-- JUMP
	--==================================================

	local CurrentVelocity = Root.AssemblyLinearVelocity

	local JumpVelocity

	if Humanoid.UseJumpPower then

		JumpVelocity = Humanoid.JumpPower

	else

		JumpVelocity =
			math.sqrt(
				2 *
				workspace.Gravity *
				Humanoid.JumpHeight
			)

	end

	Root.AssemblyLinearVelocity = Vector3.new(
		CurrentVelocity.X,
		JumpVelocity,
		CurrentVelocity.Z
	)

	--==================================================
	-- HIDE C4 DA MÃO
	--==================================================

	for _, Object in ipairs(Tool:GetDescendants()) do

		if Object:IsA("BasePart") then
			Object.Transparency = 1
		end

	end

	--==================================================
	-- BOMB POSITION
	--==================================================

	local FeetPosition =
		Root.Position -
		Vector3.new(0, 2.6, 0)

	local BombPosition =
		FeetPosition +
		Vector3.new(0, 0.45, 0)

	CreateBomb(BombPosition)

	--==================================================
	-- COOLDOWN
	--==================================================

	task.delay(Config.Cooldown, function()

		if Tool and Tool.Parent then

			for _, Object in ipairs(Tool:GetDescendants()) do

				if Object:IsA("BasePart") then
					Object.Transparency = 0
				end

			end

		end

	end)

	task.delay(Config.Cooldown, function()
		Cooldown = false
	end)

end)

